# Copy this file to .env and fill it in. Never commit .env.
# (If you skip this step, `python app.py` will generate a .env for you on first run.)

# Signs session cookies and CSRF tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-secret

# Root secret the vault encryption keys are derived from.
# LOSE THIS AND EVERY SAVED PASSWORD BECOMES UNREADABLE. Back it up somewhere safe.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VAULT_ENCRYPTION_KEY=generate-a-secure-key

DATABASE_URL=sqlite:///instance/passvault.db

# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
# Idle minutes before the login session expires
SESSION_LIFETIME_MINUTES=30
LOGIN_RATE_LIMIT=5 per minute
DEBUG=false
